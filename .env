# ==============================================================================
# CONVOCATION ASSISTANT AI AGENT - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials.
# This file must NEVER be committed to version control.

# Server Configuration
PORT=3000
NODE_ENV=development

# Google Gemini API Configuration
# Get your free API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AQ.Ab8RN6L03ZVGXn6f_ok8sYiDrA3B6boCLK9Q6UUUooT78_y6gw
GEMINI_MODEL=gemini-2.5-flash

# Default Institution ID
# Default is 'snjb_coe' (SNJB's Late Sau. K. B. Jain College of Engineering, Chandwad)
DEFAULT_INSTITUTION_ID=snjb_coe

# ==============================================================================
# FIREBASE SERVER-SIDE CONFIGURATION (Firebase Admin SDK)
# ==============================================================================
# Option A: Path to serviceAccountKey.json downloaded from Firebase Console
# (Project Settings -> Service accounts -> Generate new private key)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option B: Directly provide Firebase Admin credentials as environment variables
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ==============================================================================
# FIREBASE CLIENT-SIDE CONFIGURATION (For Admin Dashboard Authentication)
# ==============================================================================
# These public keys allow the admin browser dashboard to authenticate with Firebase Auth.
# (Project Settings -> General -> Your apps -> Web app -> SDK setup and configuration)
CLIENT_FIREBASE_API_KEY=your_public_client_api_key
CLIENT_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
CLIENT_FIREBASE_PROJECT_ID=your_firebase_project_id
CLIENT_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
CLIENT_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
CLIENT_FIREBASE_APP_ID=your_client_app_id

# ==============================================================================
# LOCAL / DEMO ADMIN MASTER SECRET (For offline testing or viva demonstrations)
# ==============================================================================
# When running offline or before configuring a live Firebase project,
# you can use this key to test administrative operations securely.
ADMIN_DEV_KEY=convocation_admin_secret_dev_key_2025
